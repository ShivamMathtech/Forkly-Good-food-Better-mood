# No environment file is needed for the Vercel demo.
# demo = browser-local demo; api = real backend only; auto = try API once, then use demo if unavailable.
VITE_DATA_MODE=demo
# For a remote API, include /api. For local development, keep /api and use npm run dev:full.
VITE_API_URL=/api
PORT=4000
HOST=127.0.0.1
# Required for a separately hosted frontend in API mode. Exact origins, comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
# Optional DB_PATH defaults to server/data/forkly.sqlite
# DB_PATH=/absolute/persistent/path/forkly.sqlite
